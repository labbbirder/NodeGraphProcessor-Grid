#HeadContainer {
    flex-direction: row-reverse;
    position: absolute;
    right: 2px;
    left: 96px;
    height: 21px;
}

#Constant {
    margin-right: 21px;
}

.unity-property-field__label {
    min-height: 21px;
}

#unity-content {
    border-left-width: 1px;
    border-left-color : gray;
    margin-left: 8px;
    padding-left: 12px;
}

ToggleButton {
    border-width: 1px;
    border-radius: 2px;
    width:18px;
}

ToggleButton>#icon
{
    position:absolute;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(192,192,192,1);
    bottom:1px;
    top:1px;
    left:1px;
    right:1px;
}

#ProcedureView
{
    background-color: rgba(0, 0, 0, 0.28);
    padding: 2px;
}

#ProcedureView>ListView
{
    padding-top:8px;
    padding-bottom:8px;
}

#ProcedureView>#Footer
{
    flex-direction:row
}

#ProcedureView>#Footer>#AddButton
{
    flex-grow: 1;
    margin: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

#ProcedureView>#Footer>#PlayButton
{
    height: 21px;
    width: 21px;
    padding: 2px;
    margin: 0;
    margin-left: -1px;
    border-top-left-radius: 0;
    border-bottom-left-radius: 0;
    background-image:url("../Textures/mdi--play.png")
}

#ProcedureItem
{
    flex-direction: row;
    align-items:center;
    padding-left:21px;
}

#ProcedureItem>Image
{
    height:16px;
    width:16px;
    margin-right:16px;
    cursor:pan;
}

#ProcedureItem>PropertyField
{
    flex-grow:1;
}


#ProcedureItem:checked
{
    background-color: #048;
}

.toggle-button__active
{
    background-color: #2e5e85;
    border-color: #555;
}

#BrowseItem
{
    flex-direction: row;
    flex-grow:1;
    align-items: center;
}

#BrowseItem.category {
    margin-left: 2px;
    -unity-font-style: bold;
}

#BrowseItem.item {
    margin-left: 21px;
}

TreeView#tree #unity-tree-view__item-toggle{
    display:none;
}

#BrowseItem>Image{
    width: 32px;
}

#InstructionBrowseView>#Head {
    margin-bottom:2px;
    margin-top:2px;
}

#InstructionBrowseView
{
    border-width: 1px;
    border-color: #222;
}

#InstructionBrowseView #imgSearch
{
    background-image: url("../Textures/iconamoon--search-bold.png");
}
