    {{~ for cnt in 2..6 ~}}
    static partial class PoolableTuple
    {
        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public static PoolableTuple<T1{{for i in 2..cnt}}, T{{i}}{{end}}> Get<T1{{for i in 2..cnt}}, T{{i}}{{end}}>(T1 arg1{{for i in 2..cnt}} ,T{{i}} arg{{i}}{{end}})
        {
            return Storage<T1{{for i in 2..cnt}}, T{{i}}{{end}}>.Get(arg1{{for i in 2..cnt}} ,arg{{i}}{{end}});
        }

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public static PoolableTuple<T1{{for i in 2..cnt}}, T{{i}}{{end}}> ToPoolable<T1{{for i in 2..cnt}}, T{{i}}{{end}}>(in this ValueTuple<T1{{for i in 2..cnt}}, T{{i}}{{end}}> tuple)
        {
            return Get(tuple.Item1{{for i in 2..cnt}} ,tuple.Item{{i}}{{end}});
        }

        [MethodImpl(MethodImplOptions.AggressiveInlining)]
        public static ValueTuple<T1{{for i in 2..cnt}}, T{{i}}{{end}}> ToValueTuple<T1{{for i in 2..cnt}}, T{{i}}{{end}}>(this PoolableTuple<T1{{for i in 2..cnt}}, T{{i}}{{end}}> tuple)
        {
