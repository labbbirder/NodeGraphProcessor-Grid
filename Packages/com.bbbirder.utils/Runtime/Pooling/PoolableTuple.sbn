        internal static class Storage<T1{{for i in 2..cnt}}, T{{i}}{{end}}>
        {
            static Stack<PoolableTuple<T1{{for i in 2..cnt}}, T{{i}}{{end}}>> stack = new();
            public static PoolableTuple<T1{{for i in 2..cnt}}, T{{i}}{{end}}> Get(T1 arg1{{for i in 2..cnt}}, T{{i}} arg{{i}}{{end}})
            {
                if (stack.TryPop(out var result))
                {
                    {{~for i in 1..cnt~}}
                    result.arg{{i}} = arg{{i}};
                    {{~end~}}
                    return result;
                }
                else
                {
                    return new(arg1{{for i in 2..cnt}}, arg{{i}}{{end}});
                }
            }

            public static void Release(PoolableTuple<T1{{for i in 2..cnt}}, T{{i}}{{end}}> tuple)
            {
                {{~for i in 1..cnt~}}
                tuple.arg{{i}} = default;
                {{~end~}}
                stack.Push(tuple);
            }
        }
    }

    public class PoolableTuple<T1{{for i in 2..cnt}}, T{{i}}{{end}}> : IDisposable
    {
        {{~for i in 1..cnt~}}
        public T{{i}} arg{{i}};
        {{~end~}}

        public PoolableTuple(T1 arg1{{for i in 2..cnt}}, T{{i}} arg{{i}}{{end}})
        {
