ToolbarOverlayContainer .unity-overlay
{
    flex-shrink:1;
}

.overlay-header
{
    flex-shrink:0;
}

#overlay-scene-containers > OverlayContainer > .unity-overlay
{
    flex-shrink:1;
    /* flex-grow:1; */
}


.overlay-layout--toolbar-horizontal,
.overlay-layout--toolbar-horizontal>#unity-overlay,
.overlay-layout--toolbar-horizontal>#unity-overlay>#overlay-content
{
    /* flex-grow:1; */
    width:100%;
}
